use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\analyze_posthog\Hook\AnalyzePosthogHooks;

/**
 * @file
 * Provides PostHog analytics integration for the Analyze module.
 */

/**
 * Implements hook_help().
 */
#[LegacyHook]
function analyze_posthog_help($route_name, $route_match) {
  return \Drupal::service(AnalyzePosthogHooks::class)->help($route_name, $route_match);
}
